# Copy to .env.server locally. Never commit the real values.
NEXCONN_APP_KEY=your-nexconn-app-key
NEXCONN_APP_SECRET=your-nexconn-app-secret
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated exact browser origins; include localhost for local development.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
